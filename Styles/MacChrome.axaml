<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackdropBrush" Color="#FFF6F6F8" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#EFF1F2F5" />
                    <SolidColorBrush x:Key="ToolbarBrush" Color="#F7F7F9FB" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#F7F7F9FB" />
                    <SolidColorBrush x:Key="ControlFillBrush" Color="#F1F2F4F7" />
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ControlPressedBrush" Color="#E7ECF2F8" />
                    <SolidColorBrush x:Key="ComboPopupBrush" Color="#FBFFFFFF" />
                    <SolidColorBrush x:Key="ComboItemHoverBrush" Color="#EFF5FF" />
                    <SolidColorBrush x:Key="ComboItemSelectedBrush" Color="#1D0A84FF" />
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="MacTextBrush" Color="#F017181B" />
                    <SolidColorBrush x:Key="MacSecondaryTextBrush" Color="#B12D3037" />
                    <SolidColorBrush x:Key="MacTertiaryTextBrush" Color="#784D535E" />
                    <SolidColorBrush x:Key="MacSeparatorBrush" Color="#2466707E" />
                    <SolidColorBrush x:Key="MacHairlineBrush" Color="#16000000" />
                    <SolidColorBrush x:Key="SubtleTintBrush" Color="#100A84FF" />
                    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#7A8C949E" />
                    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A06F7782" />
                    <SolidColorBrush x:Key="MacWarningBrush" Color="#FFFF9F0A" />
                    <SolidColorBrush x:Key="MacSuccessBrush" Color="#FF34C759" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackdropBrush" Color="#F018191D" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#D91E2026" />
                    <SolidColorBrush x:Key="ToolbarBrush" Color="#E0202228" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#F02A2D34" />
                    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#CC252831" />
                    <SolidColorBrush x:Key="ControlFillBrush" Color="#3D333740" />
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#5740484F" />
                    <SolidColorBrush x:Key="ControlPressedBrush" Color="#6B444A54" />
                    <SolidColorBrush x:Key="ComboPopupBrush" Color="#F22B2F38" />
                    <SolidColorBrush x:Key="ComboItemHoverBrush" Color="#4A3A414C" />
                    <SolidColorBrush x:Key="ComboItemSelectedBrush" Color="#3A0A84FF" />
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2FFFFFFF" />
                    <SolidColorBrush x:Key="MacTextBrush" Color="#F7F7F8FA" />
                    <SolidColorBrush x:Key="MacSecondaryTextBrush" Color="#BCD9DDE4" />
                    <SolidColorBrush x:Key="MacTertiaryTextBrush" Color="#82A9AFBA" />
                    <SolidColorBrush x:Key="MacSeparatorBrush" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="MacHairlineBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="SubtleTintBrush" Color="#220A84FF" />
                    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#94A8AFBA" />
                    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#BFC5CBD4" />
                    <SolidColorBrush x:Key="MacWarningBrush" Color="#FFFFB340" />
                    <SolidColorBrush x:Key="MacSuccessBrush" Color="#FF4CD964" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="MacAccentBrush" Color="#FF0A84FF" />
            <SolidColorBrush x:Key="MacAccentHoverBrush" Color="#FF2896FF" />
            <SolidColorBrush x:Key="MacAccentPressedBrush" Color="#FF006BDB" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFFF453A" />
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Inter, SF Pro Text, -apple-system, BlinkMacSystemFont, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource MacTextBrush}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MacTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource MacSecondaryTextBrush}" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="Foreground" Value="{DynamicResource MacTertiaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style Selector="TextBlock.eyebrow">
        <Setter Property="Foreground" Value="{DynamicResource MacTertiaryTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="14" />
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="27" />
    </Style>

    <Style Selector="TextBlock.panel-title">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style Selector="Border.titlebar">
        <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource SubtleTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinWidth" Value="22" />
    </Style>

    <Style Selector="Border.badge.quiet">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.queue-stat">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.queue-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.settings-list">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Border.status-chip">
        <Setter Property="Background" Value="{DynamicResource SubtleTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <Style Selector="Border.status-chip.success">
        <Setter Property="Background" Value="#1734C759" />
        <Setter Property="BorderBrush" Value="#4434C759" />
    </Style>

    <Style Selector="Border.status-chip.issue">
        <Setter Property="Background" Value="#18FF453A" />
        <Setter Property="BorderBrush" Value="#44FF453A" />
    </Style>

    <Style Selector="Border.modal-panel">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BoxShadow" Value="0 20 50 0 #30000000" />
    </Style>

    <Style Selector="Grid.footer-row">
        <Setter Property="Margin" Value="0,14,0,0" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <Track Name="PART_Track"
                           Orientation="{TemplateBinding Orientation}"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.Thumb>
                            <Thumb Name="PART_Thumb"
                                   Background="{DynamicResource ScrollThumbBrush}" />
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="8" />
        <Setter Property="Margin" Value="2,2,0,2" />
    </Style>

    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="2,0,2,2" />
    </Style>

    <Style Selector="ScrollBar Thumb">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
    </Style>

    <Style Selector="ScrollBar Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacHairlineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MacTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.48" />
    </Style>

    <Style Selector="Button.compact">
        <Setter Property="MinHeight" Value="29" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button.toolbar">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.toolbar:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource MacAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource MacAccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacAccentHoverBrush}" />
    </Style>

    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource MacAccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacAccentPressedBrush}" />
    </Style>

    <Style Selector="Button.sidebar-item">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource MacSecondaryTextBrush}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.sidebar-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MacTextBrush}" />
    </Style>

    <Style Selector="Button.sidebar-item.active">
        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MacTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacHairlineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MacTextBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource MacAccentBrush}" />
    </Style>

    <Style Selector="TextBox.search-field">
        <Setter Property="Height" Value="35" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="12,5" />
    </Style>

    <Style Selector="TextBox.filter-field">
        <Setter Property="Height" Value="31" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacHairlineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MacTextBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ToggleButton Name="PART_DropDownButton"
                                  IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0"
                                  Focusable="False">
                        <ToggleButton.Template>
                            <ControlTemplate>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Background="Transparent"
                                                  Padding="0" />
                            </ControlTemplate>
                        </ToggleButton.Template>

                        <Border Name="ComboChrome"
                                MinHeight="{TemplateBinding MinHeight}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <materialIcons:MaterialIcon Grid.Column="1"
                                                            Kind="ChevronDown"
                                                            Width="15"
                                                            Height="15"
                                                            Foreground="{DynamicResource MacSecondaryTextBrush}"
                                                            VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ToggleButton>

                    <Popup Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Bottom"
                           VerticalOffset="6"
                           MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border Name="DropDownChrome"
                                Background="{DynamicResource ComboPopupBrush}"
                                BorderBrush="{DynamicResource MacHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="5"
                                ClipToBounds="True"
                                BoxShadow="0 16 42 0 #24000000">
                            <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Name="PART_ItemsPresenter" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#ComboChrome">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>

    <Style Selector="ComboBox:pressed /template/ Border#ComboChrome">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>

    <Style Selector="ComboBox:focus /template/ Border#ComboChrome">
        <Setter Property="BorderBrush" Value="{DynamicResource MacAccentBrush}" />
        <Setter Property="BoxShadow" Value="0 0 0 3 #180A84FF" />
    </Style>

    <Style Selector="ComboBox:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MacTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="ItemChrome"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <ContentPresenter Grid.Column="0"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <materialIcons:MaterialIcon Grid.Column="1"
                                                    Kind="Check"
                                                    Width="15"
                                                    Height="15"
                                                    IsVisible="{TemplateBinding IsSelected}"
                                                    Foreground="{DynamicResource MacAccentBrush}"
                                                    VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ Border#ItemChrome">
        <Setter Property="Background" Value="{DynamicResource ComboItemHoverBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ Border#ItemChrome">
        <Setter Property="Background" Value="{DynamicResource ComboItemSelectedBrush}" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="Transparent"
                                  BorderThickness="0"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource SubtleTintBrush}" />
    </Style>

    <Style Selector="Grid.result-row">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Grid.result-row.download-selected">
        <Setter Property="Background" Value="{DynamicResource SubtleTintBrush}" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Foreground" Value="{DynamicResource MacAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    </Style>

    <Style Selector="CheckBox.selection-check">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="SelectionBox"
                        Width="16"
                        Height="16"
                        CornerRadius="5"
                        Background="Transparent"
                        BorderBrush="{DynamicResource MacHairlineBrush}"
                        BorderThickness="1">
                    <materialIcons:MaterialIcon Kind="Check"
                                                Width="12"
                                                Height="12"
                                                IsVisible="{TemplateBinding IsChecked}"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox.selection-check:pointerover /template/ Border#SelectionBox">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    </Style>

    <Style Selector="CheckBox.selection-check:checked /template/ Border#SelectionBox">
        <Setter Property="Background" Value="{DynamicResource MacAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacAccentBrush}" />
    </Style>

    <Style Selector="CheckBox.macos-switch">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Width="42"
                      Height="24">
                    <Border Name="SwitchTrack"
                            Width="42"
                            Height="24"
                            CornerRadius="12"
                            Background="#FFD7D8DC" />
                    <Border Name="SwitchKnob"
                            Width="20"
                            Height="20"
                            Margin="2"
                            CornerRadius="10"
                            Background="White"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            BoxShadow="0 1 3 0 #33000000" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox.macos-switch:pointerover /template/ Border#SwitchTrack">
        <Setter Property="Background" Value="#FFCBCDCE" />
    </Style>

    <Style Selector="CheckBox.macos-switch:checked /template/ Border#SwitchTrack">
        <Setter Property="Background" Value="#FF34C759" />
    </Style>

    <Style Selector="CheckBox.macos-switch:checked:pointerover /template/ Border#SwitchTrack">
        <Setter Property="Background" Value="#FF30D158" />
    </Style>

    <Style Selector="CheckBox.macos-switch:checked /template/ Border#SwitchKnob">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="CheckBox.macos-switch:pressed /template/ Border#SwitchKnob">
        <Setter Property="Width" Value="22" />
    </Style>
</Styles>
