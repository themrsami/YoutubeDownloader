<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PremiumYoutubeDownloader.App"
             Name="Premium YouTube Downloader"
             xmlns:local="using:PremiumYoutubeDownloader"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <!-- macOS application menu. Without it Avalonia shows a generic "About Avalonia" item. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Settings…"
                            Gesture="Meta+OemComma"
                            Click="OnSettingsMenuItemClick" />
            <NativeMenuItem Header="Show Download Queue"
                            Click="OnQueueMenuItemClick" />
        </NativeMenu>
    </NativeMenu.Menu>
  
    <Application.Styles>
        <themes:MaterialTheme PrimaryColor="Teal" SecondaryColor="Amber" />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://PremiumYoutubeDownloader/Styles/MacChrome.axaml" />
    </Application.Styles>
</Application>
